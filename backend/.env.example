# ── CineAI Backend Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Format: redis://default:password@host:port
REDIS_URL=redis://default:yourpassword@your-redis.upstash.io:6379

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Local dev: QDRANT_HOST=localhost, QDRANT_PORT=6333, QDRANT_API_KEY=
# Qdrant Cloud: QDRANT_HOST=xyz.qdrant.io, QDRANT_PORT=6333, QDRANT_API_KEY=your-key
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── TMDb API ──────────────────────────────────────────────────────────────────
# Get free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
