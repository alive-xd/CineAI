# .env.prod.example
# Production environment variables.
# Copy to .env.prod, fill in all values, NEVER commit to git.
#
# Generate SECRET_KEY with:  openssl rand -hex 32
# Generate REDIS_PASSWORD with: openssl rand -base64 24

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-with-openssl-rand-hex-32-minimum-64-chars-recommended

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=cineai
POSTGRES_USER=cineai_user
POSTGRES_PASSWORD=strong-random-password-here

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=strong-redis-password-here

# ── Qdrant Cloud (get from cloud.qdrant.io) ────────────────────────────────────
# For self-hosted, leave QDRANT_API_KEY empty and use internal networking
QDRANT_HOST=your-cluster.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── TMDb API ───────────────────────────────────────────────────────────────────
TMDB_API_KEY=your-tmdb-v3-api-key

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
